					PaddingTop = UDim.new(0, 4),
					PaddingBottom = UDim.new(0, 4)
				}),
				Create("UIListLayout", {
					Padding = UDim.new(0, 2)
				})
			}), "ScrollBar")

			local waitClick = false

			local function CloseDropdown()
				if waitClick then return end
				waitClick = true
				CreateTween({Arrow, "Rotation", 0, 0.2})
				CreateTween({DropFrame, "Size", UDim2.new(0, DropdownFrame.Size.X.Offset, 0, 0), 0.2, true})
				NoClickFrame.Visible = false
				waitClick = false
			end

			local function GetFrameSize()
				local optionCount = #ScrollFrame:GetChildren() - 2
				local optionHeight = 22
				local padding = 8
				local spacing = math.max(0, (optionCount - 1) * 2)
				local totalHeight = math.max(26, (optionCount * optionHeight) + padding + spacing)
				return UDim2.new(0, DropdownFrame.Size.X.Offset, 0, math.min(totalHeight, 120))
			end

			local function CalculatePos()
				local FramePos = DropdownFrame.AbsolutePosition
				local FrameSize = DropdownFrame.AbsoluteSize
				local ScreenSize = ScreenGui.AbsoluteSize
				local DropSize = GetFrameSize()

				local ClampX = math.clamp(FramePos.X, 0, ScreenSize.X - DropSize.X.Offset)
				local TargetY = FramePos.Y + FrameSize.Y + 2
				local TargetAnchor = Vector2.new(0, 0)

				if TargetY + DropSize.Y.Offset > ScreenSize.Y then
					TargetY = FramePos.Y - 2
					TargetAnchor = Vector2.new(0, 1)
				end

				DropFrame.AnchorPoint = TargetAnchor
				DropFrame.Position = UDim2.fromOffset(ClampX / UIScale, TargetY / UIScale)
			end

			local function OpenDropdown()
				if waitClick then return end
				waitClick = true
				NoClickFrame.Visible = true
				CalculatePos()
				CreateTween({Arrow, "Rotation", 180, 0.2})
				local targetSize = GetFrameSize()
				CreateTween({DropFrame, "Size", targetSize, 0.2, true})
				waitClick = false
			end

			local AddNewOptions, GetOptions, AddOption, RemoveOption, Selected do
				local Default = type(OpDefault) ~= "table" and {OpDefault} or OpDefault
				local MultiSelect = DMultiSelect
				local Options = {}
				Selected = MultiSelect and {} or CheckFlag(Flag) and GetFlag(Flag) or Default[1]

				if MultiSelect then
					for index, Value in pairs(CheckFlag(Flag) and GetFlag(Flag) or Default) do
						if type(index) == "string" and (DOptions[index] or table.find(DOptions, index)) then
							Selected[index] = Value
						elseif DOptions[Value] then
							Selected[Value] = true
						end
					end
				end

				local function CallbackSelected()
					SetFlag(Flag, MultiSelect and Selected or tostring(Selected))
					Funcs:FireCallback(Callback, Selected)
				end

				local function UpdateLabel()
					if MultiSelect then
						local list = {}
						for index, Value in pairs(Selected) do
							if Value then table.insert(list, index) end
						end
						ActiveLabel.Text = #list > 0 and table.concat(list, ", ") or "Select..."
					else
						ActiveLabel.Text = tostring(Selected or "Select...")
					end
				end

				local function UpdateSelected()
					for _,v in pairs(Options) do
						local isSelected = (MultiSelect and v.Stats) or (v.Value == Selected)
						local nodes = v.nodes
						
						if isSelected then
							CreateTween({nodes[1], "BackgroundTransparency", 0.2, 0.15})
							CreateTween({nodes[2], "BackgroundTransparency", 0.1, 0.15})
							CreateTween({nodes[3], "TextTransparency", 0, 0.15})
						else
							CreateTween({nodes[1], "BackgroundTransparency", 0.8, 0.15})
							CreateTween({nodes[2], "BackgroundTransparency", 1, 0.15})
							CreateTween({nodes[3], "TextTransparency", 0.2, 0.15})
						end
					end
					UpdateLabel()
				end

				local function SelectOption(Option)
					if MultiSelect then
						Option.Stats = not Option.Stats
						Selected[Option.Name] = Option.Stats
					else
						Selected = Option.Value
						CloseDropdown()
					end
					CallbackSelected()
					UpdateSelected()
				end

				AddOption = function(index, Value)
					local Name = tostring(type(index) == "string" and index or Value)
					if Options[Name] then return end

					Options[Name] = { index = index, Value = Value, Name = Name, Stats = false }
					if MultiSelect then
						Options[Name].Stats = Selected[Name] or false
					end

					local OptionButton = Make("Button", ScrollFrame, {
						Name = "Option",
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 0.8
					})
					Make("Corner", OptionButton, UDim.new(0, 4))

					local IsSelectedIndicator = InsertTheme(Create("Frame", OptionButton, {
						Position = UDim2.new(0, 4, 0.5, 0),
						Size = UDim2.new(0, 4, 0, 4),
						BackgroundColor3 = Theme["Color Theme"],
						BackgroundTransparency = 1,
						AnchorPoint = Vector2.new(0, 0.5)
					}), "Theme")
					Make("Corner", IsSelectedIndicator, UDim.new(0.5, 0))

					local OptionNameLabel = InsertTheme(Create("TextLabel", OptionButton, {
						Size = UDim2.new(1, -12, 1),
						Position = UDim2.fromOffset(10, 0),
						Text = Name,
						TextColor3 = Theme["Color Text"],
						Font = Enum.Font.GothamBold,
						TextXAlignment = "Left",
						BackgroundTransparency = 1,
						TextTransparency = 0.2,
						TextSize = 10
					}), "Text")

					OptionButton.Activated:Connect(function() SelectOption(Options[Name]) end)
					Options[Name].nodes = {OptionButton, IsSelectedIndicator, OptionNameLabel}
				end

				RemoveOption = function(index)
					local Name = tostring(type(index) == "string" and index or DOptions[index] or index)
					if Options[Name] then
						if MultiSelect then Selected[Name] = nil else Selected = nil end
						Options[Name].nodes[1]:Destroy()
						Options[Name] = nil
					end
				end

				GetOptions = function() return Options end
				AddNewOptions = function(List, Clear)
					if Clear then
						for name in pairs(Options) do RemoveOption(name) end
					end
					for i, v in pairs(List) do AddOption(i, v) end
					UpdateSelected()
				end

				AddNewOptions(DOptions)
				CallbackSelected()
				UpdateSelected()
			end

			DropdownButton.Activated:Connect(function()
				if NoClickFrame.Visible then CloseDropdown() else OpenDropdown() end
			end)
			NoClickFrame.Activated:Connect(CloseDropdown)
			MainFrame:GetPropertyChangedSignal("Visible"):Connect(CloseDropdown)

			DropdownButton.MouseEnter:Connect(function()
				CreateTween({DropdownFrame, "BackgroundTransparency", 0, 0.15})
			end)
			DropdownButton.MouseLeave:Connect(function()
				CreateTween({DropdownFrame, "BackgroundTransparency", 0.05, 0.15})
			end)

			local Dropdown = {}
			function Dropdown:Visible(...) Funcs:ToggleVisible(Button, ...) end
			function Dropdown:Destroy() Button:Destroy() NoClickFrame:Destroy() end
			function Dropdown:Callback(...) Funcs:InsertCallback(Callback, ...)(Selected) end
			function Dropdown:Add(Value, index) AddOption(index or Value, Value) UpdateSelected() end
			function Dropdown:Remove(Value) RemoveOption(Value) UpdateSelected() end
			function Dropdown:Select(Option)
				local target = Options[tostring(Option)]
				if target then SelectOption(target) end
			end
			function Dropdown:Set(Val1, Clear)
				if type(Val1) == "table" then
					AddNewOptions(Val1, not Clear)
				elseif type(Val1) == "function" then
					Callback = {Val1}
				end
			end
			return Dropdown
		end

		function Tab:AddSlider(Configs)
			local SName = Configs[1] or Configs.Name or Configs.Title or "Slider!"
			local SDesc = Configs.Desc or Configs.Description or ""
			local Min = Configs[2] or Configs.MinValue or Configs.Min or 10
			local Max = Configs[3] or Configs.MaxValue or Configs.Max or 100
			local Increase = Configs[4] or Configs.Increase or 1
			local Callback = Funcs:GetCallback(Configs, 6)
			local Flag = Configs[7] or Configs.Flag or false
			local Default = Configs[5] or Configs.Default or 25
			if CheckFlag(Flag) then Default = GetFlag(Flag) end

			local Button, LabelFunc = ButtonFrame(Container, SName, SDesc, UDim2.new(1, -200))

			local SliderHolder = Create("TextButton", Button, {
				Size = UDim2.new(0, 180, 1, 0), Position = UDim2.fromScale(1, 0), AnchorPoint = Vector2.new(1, 0), AutoButtonColor = false, Text = "", BackgroundTransparency = 1
			})

			local SliderBar = InsertTheme(Create("Frame", SliderHolder, {
				BackgroundColor3 = Theme["Color Stroke"], Size = UDim2.new(1, -35, 0, 6), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5)
			}), "Stroke")Make("Corner", SliderBar, UDim.new(1, 0))Make("Glow", SliderBar, {Transparency = 0.95})

			local Indicator = InsertTheme(Create("Frame", SliderBar, {
				BackgroundColor3 = Theme["Color Theme"], Size = UDim2.fromScale(0.3, 1), BorderSizePixel = 0
			}), "Theme")Make("Corner", Indicator, UDim.new(1, 0))

			local SliderIcon = Create("Frame", SliderBar, {
				Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.fromScale(0.3, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0
			})Make("Corner", SliderIcon, UDim.new(1, 0))

			local SliderShadow = Create("Frame", SliderIcon, {
				Size = UDim2.fromScale(1, 1),
				Position = UDim2.fromOffset(0, 1),
				BackgroundColor3 = Color3.fromRGB(0, 0, 0),
				BackgroundTransparency = 0.3,
				ZIndex = -1
			})Make("Corner", SliderShadow, UDim.new(1, 0))

			local LabelVal = InsertTheme(Create("TextLabel", SliderHolder, {
				Size = UDim2.new(0, 30, 1, 0), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundTransparency = 1, TextColor3 = Theme["Color Text"], Font = Enum.Font.GothamBold, TextSize = 12
			}), "Text")

			local function UpdateLabel(NewValue)
				Default = tonumber(string.format("%.2f", NewValue))
				LabelVal.Text = tostring(Default)
				Funcs:FireCallback(Callback, Default)
			end

			local function UpdateSliderFromValue(value)
				local percentage = (value - Min) / (Max - Min)
				local clampedPercentage = math.clamp(percentage, 0, 1)
				SliderIcon.Position = UDim2.fromScale(clampedPercentage, 0.5)
				Indicator.Size = UDim2.fromScale(clampedPercentage, 1)
				UpdateLabel(value)
			end

			local dragging = false
			SliderHolder.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					CreateTween({SliderIcon, "Size", UDim2.fromOffset(18, 18), 0.15})
					CreateTween({SliderShadow, "BackgroundTransparency", 0.1, 0.15})
					local mouse = Player:GetMouse()
					while dragging do
						local relativeX = mouse.X - SliderBar.AbsolutePosition.X
						local percentage = math.clamp(relativeX / SliderBar.AbsoluteSize.X, 0, 1)
						local newValue = Min + (Max - Min) * percentage
						local steppedValue = math.floor(newValue / Increase + 0.5) * Increase
						UpdateSliderFromValue(steppedValue)
						RunService.Heartbeat:Wait()
					end
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					if dragging then
						dragging = false
						CreateTween({SliderIcon, "Size", UDim2.fromOffset(14, 14), 0.15})
						CreateTween({SliderShadow, "BackgroundTransparency", 0.3, 0.15})
						SetFlag(Flag, Default)
					end
				end
			end)

			UpdateSliderFromValue(Default)

			local Slider = {}
			function Slider:Set(NewVal1, NewVal2)
				if type(NewVal1) == "string" and type(NewVal2) == "string" then
					LabelFunc:SetTitle(NewVal1)
					LabelFunc:SetDesc(NewVal2)
				elseif type(NewVal1) == "string" then
					LabelFunc:SetTitle(NewVal1)
				elseif type(NewVal1) == "function" then
					Callback = {NewVal1}
				elseif type(NewVal1) == "number" then
					UpdateSliderFromValue(NewVal1)
				end
			end
			function Slider:Callback(...) Funcs:InsertCallback(Callback, ...)(tonumber(Default)) end
			function Slider:Visible(...) Funcs:ToggleVisible(Button, ...) end
			function Slider:Destroy() Button:Destroy() end
			return Slider
		end

